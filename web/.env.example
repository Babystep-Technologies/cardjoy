# Web frontend environment variables.
# Copy to .env.development (or .env.local) and fill in as needed.
# `docker compose up` uses .env.development by default.

# --- Required ---
VITE_ENV=development
VITE_API_URL="http://localhost:3000"
VITE_GRAPHQL_ENDPOINT="http://localhost:3000/graphql"
VITE_PREVIEW_ENDPOINT="http://localhost:3000/p"

# Google Sign-In client ID (public). Create a Web OAuth client in Google Cloud
# Console and add http://localhost:5173 to its Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=""

# Stripe price IDs (public) for the credit packs.
VITE_STRIPE_PRICE_ID_1_CREDIT=
VITE_STRIPE_PRICE_ID_5_CREDITS=
VITE_STRIPE_PRICE_ID_10_CREDITS=

# Slack app client ID (public), for the Slack integration.
VITE_SLACK_CLIENT_ID=""

VITE_MAINTENANCE_MODE_FEATURE_FLAG=development_web_maintenance_mode_enabled

# --- Optional integrations (leave blank to disable; the feature is hidden) ---
# GIPHY (GIF search):        https://developers.giphy.com/
VITE_GIPHY_API_KEY=
# Unsplash (cover images):   https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=
# PostHog (product analytics): https://posthog.com/  (blank = analytics disabled)
VITE_POSTHOG_KEY=
