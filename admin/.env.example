# Admin frontend environment variables.
# Copy to .env.development (or .env.local) and fill in as needed.
# `docker compose up` uses .env.development by default.

# --- Required ---
VITE_ENV=development
VITE_GRAPHQL_ENDPOINT="http://localhost:3000/graphql"

# Google Sign-In client ID (public). Create a Web OAuth client in Google Cloud
# Console and add http://localhost:3002 to its Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=""
