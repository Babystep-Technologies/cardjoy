<h2>Hey <%= @rsvp.guest_name %>!</h2>

<p>A reminder that <strong><%= @invitation.title %></strong> is coming up.</p>

<% if @note.present? %>
  <div style="background-color: #f9fafb; border-left: 4px solid #d1d5db; padding: 12px 16px; margin: 20px 0;">
    <div style="white-space: pre-line;"><%= @note %></div>
    <div style="font-size: 12px; color: #6b7280; margin-top: 8px;">&mdash; <%= @invitation.user.name.presence || "Your host" %></div>
  </div>
<% end %>

<h3>Event Details</h3>
<p>
  <strong>Date:</strong> <%= @invitation.event_date.strftime("%A, %B %d, %Y") %><br/>
  <strong>Time:</strong> <%= Time.parse(@invitation.event_time).strftime("%I:%M %p") %><br/>
  <% if @invitation.location.present? %>
    <strong>Location:</strong> <%= @invitation.location %><br/>
  <% end %>
  <strong>Your RSVP:</strong> <%= @rsvp.status == "going" ? "Going" : "Maybe" %>
  <% if @rsvp.plus_one && @rsvp.plus_one_name.present? %>
    (plus one: <%= @rsvp.plus_one_name %>)
  <% end %>
</p>

<% if @calendar_links %>
  <%= render "rsvp_mailer/calendar_buttons", calendar_links: @calendar_links %>
<% end %>

<p>
  <a href="<%= @invitation_url %>" class="primary-button">View Invitation</a>
</p>

<p style="font-size: 12px; color: #6b7280; margin-top: 24px;">
  Plans changed? Visit the invitation page to update your RSVP.
</p>
